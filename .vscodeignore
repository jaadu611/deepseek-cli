# Ignore source files (only compiled code in dist is needed)
src/
main.ts
tsconfig.json

# Ignore temporary/local development files
scratch/
scraper-profile/
ds_config/

# Ignore documentation/git files
.git/
.gitignore
.vscode/

# Ignore devDependencies (vsce handles this via --skip-require or npm prune)
# But KEEP production node_modules
!node_modules/**
!dist/**
!public/**