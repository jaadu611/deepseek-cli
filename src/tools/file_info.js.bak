const fs = require('fs'); // test
const path = require('path');
const { isPathAllowed, getPermissionErrorPath } = require('../utils/permissions');

module.exports = {
  name: "file_info",
  description: "Inspects metadata of a file or directory (size, modified time, directory vs file, and line count for text files) without loading full content.",
  parameters: {
    type: "object",
    properties: {
      path: { type: "string", description: "The relative or absolute path of the file or directory to inspect." }
    },
    required: ["path"]
  },

  /**
   * Get metadata for a file or directory.
   * @param {Object} params - Parameters object
   * @param {string} params.path - The relative or absolute path of the file or directory to inspect.
   * @returns {Promise<string>} Formatted metadata string or error message.
   */
  async execute({ path: filePath }) {
    try {
      if (!filePath || typeof filePath !== 'string' || filePath.trim() === '') {
        return 'Error: Required parameter "path" is missing or empty.';
      }
      
      const resolved = path.resolve(filePath);
      if (!isPathAllowed(resolved)) {
        return getPermissionErrorPath(resolved);
      }
      
      if (!fs.existsSync(resolved)) {
        return `❌ Path does not exist: ${resolved}`;
      }
      
      const stats = fs.statSync(resolved);
      const isDir = stats.isDirectory();
      
      let info = `[Metadata for: ${resolved}]\n`;
      info += `- Type: ${isDir ? 'Directory' : 'File'}\n`;
      info += `- Created: ${stats.birthtime.toISOString()}\n`;
      info += `- Last Modified: ${stats.mtime.toISOString()}\n`;
      
      if (isDir) {
        let itemsCount = 0;
        try {
          itemsCount = fs.readdirSync(resolved).length;
        } catch {}
        info += `- Contents: ${itemsCount} immediate item(s)\n`;
      } else {
        info += `- Size: ${stats.size} bytes\n`;
        // Check if it's likely a text file and read line count
        try {
          const content = fs.readFileSync(resolved, 'utf8');
          // Basic text detection: check for null bytes in the first 8KB
          const isBinary = content.slice(0, 8000).includes('\u0000');
          if (!isBinary) {
            const lineCount = content.split('\n').length;
            info += `- Text File: Yes (${lineCount} lines)\n`;
          } else {
            info += `- Text File: No (Binary data)\n`;
          }
        } catch {
          info += `- Text File: Unknown (unreadable)\n`;
        }
      }
      
      return info;
    } catch (err) {
      return `Error retrieving metadata: ${err.message}`;
    }
  }
};
