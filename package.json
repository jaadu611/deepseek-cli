{
  "name": "deepseek-chat",
  "version": "1.2.0",
  "description": "DeepSeek AI CLI & VSCode Extension Chat Panel",
  "icon": "public/deepseek-color.png",
  "main": "dist/src/extension.js",
  "publisher": "deepseek-cli",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": ["onView:deepseek-cli-sidebar"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deepseek-sidebar-container",
          "title": "DeepSeek",
          "icon": "public/deepseek-gray.svg"
        }
      ]
    },
    "views": {
      "deepseek-sidebar-container": [
        {
          "type": "webview",
          "id": "deepseek-cli-sidebar",
          "name": "DeepSeek Chat"
        }
      ]
    }
  },
  "bin": {
    "deepseek-cli": "./dist/main.js",
    "ds": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "copy-assets": "node copy_assets.js",
    "watch": "npm run copy-assets && tsc -w",
    "start": "node dist/main.js",
    "dev": "node src/cli/cli.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "glob": "^10.4.1",
    "markdown-it": "^14.2.0",
    "markdown-it-multimd-table": "^4.2.3",
    "markdown-it-table": "^4.1.1",
    "playwright": "^1.60.0",
    "playwright-stealth": "^0.0.1",
    "vscode-languageserver-protocol": "^3.18.0",
    "vscode-languageserver-textdocument": "^1.0.12",
    "web-tree-sitter": "^0.26.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jaadu611/deepseek-cli"
  },
  "devDependencies": {
    "@types/node": "^20.19.42",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.9.3"
  }
}
